# 复制为 .env 后填写。MYSQL_PASSWORD / APP_MASTER_KEY 没有默认值，
# 缺失或仍是示例值（含 change-me）后端会直接启动失败。
# 本机开发：SPRING_PROFILES_ACTIVE=dev；部署到任何可被访问的环境：prod
# dev 会按 .properties 语法解析本文件，路径请用 / 而不是裸反斜杠（\ 会被当成转义符）。

# ===== MySQL (container host port 33307, intentionally NOT 3306) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33307
MYSQL_DATABASE=knowbase
MYSQL_USER=knowbase
MYSQL_PASSWORD=change-me-app
MYSQL_ROOT_PASSWORD=change-me-root

# ===== Redis (container host port 16380) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=16380
REDIS_PASSWORD=

# ===== Qdrant =====
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowbase_chunks
QDRANT_API_KEY=
QDRANT_TIMEOUT_MS=2000

# ===== Java service =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===== Python AI service =====
PYTHON_SERVICE_URL=http://127.0.0.1:8090
INTERNAL_TOKEN=change-me-internal-token

# ===== LLM (OpenAI-compatible) =====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# ===== File storage =====
UPLOAD_DIR=./data/uploads

# ===== Secrets =====
# 32-byte key, base64. Generate with: openssl rand -base64 32
APP_MASTER_KEY=
