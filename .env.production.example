# Copy this file to .env before running deploy/compose.prod.yml.
# Generate independent random values; do not reuse the development secrets.

MYSQL_DATABASE=knowbase
MYSQL_USER=knowbase
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

REDIS_PASSWORD=replace-with-a-long-random-redis-password
QDRANT_API_KEY=replace-with-a-long-random-qdrant-key
QDRANT_COLLECTION=knowbase_chunks
QDRANT_TIMEOUT_MS=3000

INTERNAL_TOKEN=replace-with-at-least-32-random-characters
APP_MASTER_KEY=replace-with-base64-of-exactly-32-random-bytes

HTTP_PORT=80
HTTPS_PORT=443
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=text-embedding-3-small

QA_TOP_K=5
QA_SCORE_THRESHOLD=0.2
QA_RATE_LIMIT_PER_MINUTE=20
QA_CONTEXT_TOKEN_BUDGET=3000
QA_MAX_CONTEXT_CHUNKS=8
QA_STREAM_TIMEOUT_MS=90000
